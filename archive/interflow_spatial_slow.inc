/* interflow_spatial_slow.inc
   Truly spatial delayed interflow reservoir.

   Purpose
   -------
   This module replaces immediate drainage-to-river routing with slow, cell-to-cell
   lateral subsurface transfer. Water generated by soil drainage is first stored in
   interflowStore[x][y]. Each model day, only a fraction is mobilised. Mobilised
   water moves at most one grid cell downslope and is added to the receiving cell's
   interflowIn[x][y], so it becomes available only on the next day. Water only
   enters dsc when it reaches a neighbouring channel cell, dam, or lake.

   Required arrays, declared and initialized in main before the time loop:
   ---------------------------------------------------------------------
     float interflowStore[xSize][ySize];  // mm, delayed subsurface storage
     float interflowIn[xSize][ySize];     // mm, water arriving next day

   Suggested initialization:
   -------------------------
     for(int x=0; x<xSize; x++)
       for(int y=0; y<ySize; y++) {
         interflowStore[x][y] = 0.0f;
         interflowIn[x][y]    = 0.0f;
       }

   Suggested parameters, declared in main:
   ---------------------------------------
     float kInterflowBase       = 0.035f; // d-1; slow reservoir, tau about 29 d
     float kInterflowMin        = 0.003f; // d-1
     float kInterflowMax        = 0.120f; // d-1
     float kInterflowDrainedFac = 1.75f;  // drained soils move faster, but still spatial
     float interflowSlopeFac    = 4.0f;   // slope sensitivity
     float interflowDrainFac    = 0.8f;   // drainageRate2 sensitivity
     float interflowChannelFrac = 1.0f;   // fraction reaching channel counted as Qd_cum

   Coupling from soil_waterbalance.inc:
   ------------------------------------
   Replace direct drainage routing:

     Qd_cum += Qd_act * (dx*dy)/1000;
     short int riverX=drainRoute[x][y][0];
     short int riverY=drainRoute[x][y][1];
     dsc[riverX][riverY]+=Qd_act;

   with:

     interflowStore[x][y] += Qd_act;

   Include order:
   --------------
     #include "include/soil_waterbalance.inc"
     #include "include/interflow_spatial_slow.inc"
     #include "include/flacc_DAG.inc"

   Units:
   ------
     interflowStore, interflowIn, qRelease, qPart are mm over the source cell area.
     Q_interflow_cum and Qd_cum are m3/day.
*/

float Q_interflow_cum = 0.0f;  // m3/day reaching stream through delayed interflow

// -----------------------------------------------------------------------------
// 1. Move previous-day incoming interflow into storage and clear inbox.
// -----------------------------------------------------------------------------
for(int x=1; x<xSize-1; x++)
{
    for(int y=1; y<ySize-1; y++)
    {
        if(dem[x][y] == noData) continue;

        if(interflowIn[x][y] > 0.0f)
        {
            interflowStore[x][y] += interflowIn[x][y];
            interflowIn[x][y] = 0.0f;
        }
        else if(interflowIn[x][y] < 0.0f)
        {
            // Defensive: this should never happen, but prevents hidden negative stores.
            interflowIn[x][y] = 0.0f;
        }

        if(interflowStore[x][y] < 0.0f) interflowStore[x][y] = 0.0f;
    }
}

// -----------------------------------------------------------------------------
// 2. Release a small fraction of local storage and move it one cell downslope.
//    Important: receiving water is put in interflowIn, so it cannot move again
//    until tomorrow. This is what makes the process spatially explicit and slow.
// -----------------------------------------------------------------------------
for(int x=1; x<xSize-1; x++)
{
    for(int y=1; y<ySize-1; y++)
    {
        if(dem[x][y] == noData) continue;
        if(lakes[x][y] != noData) continue;
        if(dams[x][y]  != noData) continue;
        if(channel[x][y] == 1) continue;
        if(interflowStore[x][y] <= 0.0f) continue;

        // Optional frozen-soil gate. Keep water stored until soil can transmit.
        if(tm[index] <= drainageTempSD) continue;

        // Spatially variable recession/mobility coefficient.
        // Drained mineral soils are faster but still travel cell-by-cell.
        bool drainedSoil = (texture[x][y] >= 12 && texture[x][y] <= 19);

        float k = kInterflowBase;
        if(drainedSoil) k *= kInterflowDrainedFac;
        if(drainageRate2[x][y] > 0.0f) k *= (1.0f + interflowDrainFac * drainageRate2[x][y]);
        if(slope[x][y] > 0.0f)         k *= (1.0f + interflowSlopeFac * slope[x][y]);

        if(k < kInterflowMin) k = kInterflowMin;
        if(k > kInterflowMax) k = kInterflowMax;

        float qRelease = k * interflowStore[x][y]; // mm/day mobilised from this cell
        if(qRelease > interflowStore[x][y]) qRelease = interflowStore[x][y];
        if(qRelease <= 0.0f) continue;

        // Find valid downslope receivers using your existing MFD weights d[x][y][wIndex].
        // Channels/lakes/dams are valid terminal receivers. Ordinary cells receive
        // water into interflowIn for tomorrow.
        float wSum = 0.0f;
        int wIndex = 0;

        for(int X=-1; X<=1; X++)
        {
            for(int Y=-1; Y<=1; Y++)
            {
                if(X==0 && Y==0)
                {
                    wIndex++;
                    continue;
                }

                int nx = x + X;
                int ny = y + Y;

                if(nx < 0 || nx >= xSize || ny < 0 || ny >= ySize)
                {
                    wIndex++;
                    continue;
                }
                if(dem[nx][ny] == noData)
                {
                    wIndex++;
                    continue;
                }

                float w = d[x][y][wIndex];
                if(w > 0.0f && dem[nx][ny] < dem[x][y])
                    wSum += w;

                wIndex++;
            }
        }

        // If no downslope receiver exists, keep the water in storage.
        if(wSum <= 0.0f) continue;

        // Remove from source store only after we know it can be routed.
        interflowStore[x][y] -= qRelease;
        if(interflowStore[x][y] < 0.0f) interflowStore[x][y] = 0.0f;

        wIndex = 0;
        for(int X=-1; X<=1; X++)
        {
            for(int Y=-1; Y<=1; Y++)
            {
                if(X==0 && Y==0)
                {
                    wIndex++;
                    continue;
                }

                int nx = x + X;
                int ny = y + Y;

                if(nx < 0 || nx >= xSize || ny < 0 || ny >= ySize)
                {
                    wIndex++;
                    continue;
                }
                if(dem[nx][ny] == noData)
                {
                    wIndex++;
                    continue;
                }

                float w = d[x][y][wIndex];
                if(w <= 0.0f || dem[nx][ny] >= dem[x][y])
                {
                    wIndex++;
                    continue;
                }

                float qPart = qRelease * w / wSum; // mm over source cell

                if(channel[nx][ny] == 1)
                {
                    // Interflow has reached the stream network. Add to channel water
                    // depth before flacc_DAG.inc, so it is included in outlet routing.
                    dsc[nx][ny] += qPart;
                    Q_interflow_cum += interflowChannelFrac * qPart * dx * dy / 1000.0f;
                }
                else if(lakes[nx][ny] != noData)
                {
                    int locLake = -1;
                    for(int lakeIndex=0; lakeIndex<nrLakes; lakeIndex++)
                    {
                        if(lakes[nx][ny] == lakeStats[lakeIndex][8])
                        {
                            locLake = lakeIndex;
                            break;
                        }
                    }
                    if(locLake >= 0)
                    {
                        lakeStats[locLake][7] += (qPart * dx * dy / 1000.0f) / lakeStats[locLake][0];
                        Q_lake += qPart * dx * dy / 1000.0f;
                    }
                    else
                    {
                        // If lake lookup fails, do not lose water.
                        interflowIn[nx][ny] += qPart;
                    }
                }
                else if(dams[nx][ny] != noData)
                {
                    int damID = dams[nx][ny];
                    int damIndex = -1;
                    for(int i=0; i<nrDams; i++)
                    {
                        if(damStats[i][0] == damID)
                        {
                            damIndex = i;
                            break;
                        }
                    }
                    if(damIndex >= 0)
                    {
                        damStats[damIndex][4] += qPart * dx * dy / 1000.0f;
                    }
                    else
                    {
                        interflowIn[nx][ny] += qPart;
                    }
                }
                else
                {
                    // Ordinary hillslope/subsurface receiver: arrives tomorrow.
                    interflowIn[nx][ny] += qPart;
                }

                wIndex++;
            }
        }
    }
}

// Keep legacy drainage accounting alive. This is now delayed drainage volume
// reaching stream/lake/dam, not the amount generated by soil_waterbalance today.
Qd_cum += Q_interflow_cum;
